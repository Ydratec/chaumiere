# Variables publiques Supabase
# Ces valeurs sont destinées au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variables privées, serveur uniquement
# Ne jamais utiliser le préfixe NEXT_PUBLIC_ pour un secret.
SUPABASE_SECRET_KEY=

# Poivre ajouté au PIN avant hachage (chaîne aléatoire longue, ne jamais changer)
AUTH_PEPPER=

# Super-admins de l'app (identifiants de connexion, séparés par des virgules) : accès au mode admin
SUPERADMINS=

# Notifications push : générer avec `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Secret partagé avec la tâche planifiée Supabase (voir supabase/setup/notifications_cron.sql)
CRON_SECRET=
